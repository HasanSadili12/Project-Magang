// Inisialisasi LCD 20x4 I2C
LiquidCrystal_I2C lcd(0x27, 20, 4);

// URL PORTAL WEB APP GOOGLE SHEETS
const char* googleWebAppUrl = "https://script.google.com/macros/s/AKfycbywRo1wCSImbL5eDVREBQtUiIdgEZMg36G9tWMoC1z4ufOjnmCsF1LigHWZAkkVHR8/exec";

// KONFIGURASI PIN RFID RC522 (SPI) - RST DI PIN D4 (GPIO 4)
#define SS_PIN       5
#define RST_PIN      4   
MFRC522 mfrc522(SS_PIN, RST_PIN);

// KONFIGURASI PIN HARDWARE INDIKATOR
#define PIN_SENSOR   34 
#define LED_HIJAU    25 
#define LED_MERAH    26 
#define PIN_BUZZER   27 

// DATA KALIBRASI RIIL HASIL TRIM
const int ADC_KOSONG  = 430;   // Nilai ADC saat kering (0.462V)
const int ADC_PENUH   = 2882;  // Nilai ADC saat drum full (2.402V)

// SPESIFIKASI FISIK DRUM GUDANG
const float TINGGI_MAKS = 90.0;     
const float KAPASITAS_MAKS = 200.0; 

// Variabel Global Objek WiFiManager & Timer
WiFiManager wm;
BlynkTimer timer;

// Variabel Logika Transaksi & Stok
unsigned long waktuTerakhirBacaSensor = 0;
const unsigned long INTERVAL_BACA_SENSOR = 5000; 

// LOGIKA PENGHEMAT MEMORI: Mengunci log standby "System" hanya 1 jam sekali (3.600.000 ms)
unsigned long waktuTerakhirLogJam = 0;
const unsigned long INTERVAL_LOG_GOOGLE = 3600000; 

// Logika Re-connect Wi-Fi otomatis di latar belakang
unsigned long waktuTerakhirCobaKonekWiFi = 0;
const unsigned long INTERVAL_COBA_WIFI = 10000; 
unsigned long waktuGagalWiFiMulai = 0;

float volumeAwalSesi = 0.0;
bool sesiAktif = false;
unsigned long waktuSesiMulai = 0;
const unsigned long TIMEOUT_SESI = 35000; 

bool statusOnlineLama = false;
bool blynkTerinisialisasi = false;

// REGISTER KARTU RFID DATA RIIL (Nama Sesuai Kodingan)
String kartuOperator1 = "90 12 0D 55"; // Bpk. Riduwan
String kartuOperator2 = "00 DF 98 53"; // Bpk. Andi R
String namaOperatorAktif = "Anonim";

void sendSensorData() {
  long totalADC = 0;
  for (int i = 0; i < 100; i++) {
    totalADC += analogRead(PIN_SENSOR);
    delay(1); 
  }
  float rataADC = totalADC / 100.0;

  float tinggiMinyak = 0.0 + (rataADC - ADC_KOSONG) * (TINGGI_MAKS - 0.0) / (ADC_PENUH - ADC_KOSONG);
  if (tinggiMinyak < 0) tinggiMinyak = 0;
  if (tinggiMinyak > TINGGI_MAKS) tinggiMinyak = TINGGI_MAKS;

  float volumeLiterFloat = (tinggiMinyak / TINGGI_MAKS) * KAPASITAS_MAKS;
  float persentase = (volumeLiterFloat / KAPASITAS_MAKS) * 100.0;

  if (volumeLiterFloat >= 196.0) {
    volumeLiterFloat = 200.0;
    persentase = 100.0;
  }

  // Informasi Utama di Layar LCD
  lcd.setCursor(0, 1);
  lcd.print(" Volume : "); lcd.print(volumeLiterFloat, 1); lcd.print(" Ltr   ");
  lcd.setCursor(0, 2);
  lcd.print("Persen : "); lcd.print(persentase, 1); lcd.print(" %       ");

  if (!sesiAktif) {
    lcd.setCursor(0, 3);
    if (WiFi.status() == WL_CONNECTED) {
      lcd.print("TAP KARTU AMBIL OLI ");
    } else {
      lcd.print("TAP KARTU (OFFLINE) ");
    }
    
    // Logika Indikator Batas Kritis Gudang (<= 25%)
    if (persentase <= 25.0) {
      digitalWrite(LED_HIJAU, LOW);
      digitalWrite(LED_MERAH, HIGH);
      digitalWrite(PIN_BUZZER, HIGH); delay(80); digitalWrite(PIN_BUZZER, LOW);
    } else {
      digitalWrite(LED_HIJAU, HIGH);
      digitalWrite(LED_MERAH, LOW);
      digitalWrite(PIN_BUZZER, LOW);
    }

    if (WiFi.status() == WL_CONNECTED && blynkTerinisialisasi) {
      Blynk.virtualWrite(V1, volumeLiterFloat);
    }

    // Log Berkala Per Jam murni jika Standby tenang
    if (millis() - waktuTerakhirLogJam >= INTERVAL_LOG_GOOGLE || waktuTerakhirLogJam == 0) {
      kirimDataKeGoogleSheet(volumeLiterFloat, persentase, "System", "Log Berkala Per Jam");
      waktuTerakhirLogJam = millis(); 
    }

  } 
  else {
    lcd.setCursor(0, 3);
    lcd.print(namaOperatorAktif + " AMBIL OLI... ");

    float jumlahDiambil = volumeAwalSesi - volumeLiterFloat;
    if (jumlahDiambil < 0) jumlahDiambil = 0;

    if (WiFi.status() == WL_CONNECTED && blynkTerinisialisasi) {
      Blynk.virtualWrite(V1, volumeLiterFloat);
    }

    if (millis() - waktuSesiMulai > TIMEOUT_SESI) {
      sesiAktif = false;
      
      if (jumlahDiambil >= 1.0) {
        kirimDataKeGoogleSheet(volumeLiterFloat, persentase, namaOperatorAktif, "Mengambil " + String(jumlahDiambil, 1) + " L");
        waktuTerakhirLogJam = millis(); 
      }
      
      lcd.setCursor(0, 3);
      lcd.print("SESI DIKUNCI KEMBALI");
      digitalWrite(PIN_BUZZER, HIGH); delay(500); digitalWrite(PIN_BUZZER, LOW);
      delay(1500);
    }
  }
}

void cekRfidCard() {
  if (!sesiAktif) {
    if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
      String uidString = "";
      for (byte i = 0; i < mfrc522.uid.size; i++) {
        uidString += String(mfrc522.uid.uidByte[i] < 0x10 ? "0" : "");
        uidString += String(mfrc522.uid.uidByte[i], HEX);
        if (i < mfrc522.uid.size - 1) uidString += " ";
      }
      uidString.toUpperCase();

      if (uidString == kartuOperator1) {
        namaOperatorAktif = "Bpk. Riduwan";
        sesiAktif = true;
      } else if (uidString == kartuOperator2) {
        namaOperatorAktif = "Bpk. Andi R";
        sesiAktif = true;
      } else {
        lcd.setCursor(0, 3);
        lcd.print("ID BARU: " + uidString.substring(0,11));
        digitalWrite(PIN_BUZZER, HIGH); delay(1000); digitalWrite(PIN_BUZZER, LOW);
        delay(1500);
      }

      if (sesiAktif) {
        long totalADC = 0;
        for (int i = 0; i < 20; i++) totalADC += analogRead(PIN_SENSOR);
        float rataADC = totalADC / 20.0;
        float tinggiMinyak = 0.0 + (rataADC - ADC_KOSONG) * (TINGGI_MAKS - 0.0) / (ADC_PENUH - ADC_KOSONG);
        volumeAwalSesi = (tinggiMinyak / TINGGI_MAKS) * KAPASITAS_MAKS;
        
        waktuSesiMulai = millis();
        digitalWrite(PIN_BUZZER, HIGH); delay(80); digitalWrite(PIN_BUZZER, LOW); delay(80);
        digitalWrite(PIN_BUZZER, HIGH); delay(80); digitalWrite(PIN_BUZZER, LOW);
      }
      mfrc522.PICC_HaltA();
    }
  }
}

void kirimDataKeGoogleSheet(float volume, float persen, String namaOp, String statusStok) {
  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client; 
    client.setInsecure();    
    client.setTimeout(12000); // Mengunci batas waktu SSL (12 Detik) anti error -1
    
    HTTPClient http;
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    
    if (http.begin(client, googleWebAppUrl)) {
      http.addHeader("Content-Type", "application/json");
      
      JsonDocument doc;
      doc["operator"] = namaOp;
      doc["volume"] = volume;
      doc["persen"] = persen;
      doc["keterangan"] = statusStok;
      
      String jsonString;
      serializeJson(doc, jsonString);
      
      int httpResponseCode = http.POST(jsonString);
      Serial.print("HTTP Response Code Google: ");
      Serial.println(httpResponseCode); 
      
      http.end();
    }
  }
}

void setup() {
  Serial.begin(115200);
  
  // 1. SOLUSI FIX KELISTRIKAN: Jeda 5 Detik awal redam power spike sirkuit panel
  delay(5000); 

  SPI.begin();         
  mfrc522.PCD_Init();  
  
  pinMode(PIN_SENSOR, INPUT);
  pinMode(LED_HIJAU, OUTPUT);
  pinMode(LED_MERAH, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);
  analogReadResolution(12); 
  
  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("MONITOR OLI SLIDE 68");
  
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true); 

  // 2. WiFiManager Konfigurasi Simpan Kredensial Permanen
  wm.setConnectTimeout(15);          
  wm.setConfigPortalBlocking(false); 
  wm.setSaveConnect(true);           
  
  wm.autoConnect("Coolant_Monitor_AP");
  sendSensorData(); 
}

void loop() {
  wm.process(); // Menjaga ketersediaan portal Wi-Fi di background

  
  if (WiFi.status() == WL_CONNECTED) {
    if (!statusOnlineLama) {
      Serial.println("Jaringan Internet Aktif!");
      if (!blynkTerinisialisasi) {
        Blynk.config(BLYNK_AUTH_TOKEN);
        blynkTerinisialisasi = true;
      }
      Blynk.connect();
      statusOnlineLama = true;
    }
    Blynk.run();
  } 
  else {
    if (statusOnlineLama) {
      Serial.println("Jaringan Internet Terputus. Beralih ke Mode Lokal.");
      statusOnlineLama = false;
    }
    
    // Upaya sambung ulang halus reguler ke ingatan flash internal setiap 10 detik
    if (millis() - waktuTerakhirCobaKonekWiFi >= INTERVAL_COBA_WIFI) {
      WiFi.begin(); 
      waktuTerakhirCobaKonekWiFi = millis();
    }
  }

  // Cek aktivitas scan kartu RFID setiap saat
  cekRfidCard();

  // Membaca sensor reguler tiap 5 detik atau secara konstan saat sesi tuang aktif
  if (millis() - waktuTerakhirBacaSensor >= INTERVAL_BACA_SENSOR || sesiAktif) {
    sendSensorData();
    waktuTerakhirBacaSensor = millis();
  }
}
